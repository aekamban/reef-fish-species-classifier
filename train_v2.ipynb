        "# above for the real context, not the inherited function's internal label.\n",
        "full_data = [c for c in fishlib.class_names() if c not in fishlib.LOW_DATA]\n",
        "fishlib.paired_bootstrap_f1(\n",
        "    'results_v2/v2_E_targeted_original_eval.json',\n",
        "    'results_v2/v2_E_symmetric_new_eval.json',\n",
