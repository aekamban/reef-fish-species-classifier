      "source": [
        "def default_targeted_augment():\n",
        "    \"\"\"Reproduces the ORIGINAL Arm B policy for comparison: fishlib's\n",
        "    default_augment(extra=True) gated to LOW_DATA classes only via the\n",
        "    `targeted=True` flag inside fishlib._ds. Kept here only as the\n",
        "    baseline this notebook is trying to improve on.\"\"\"\n",
        "    return fishlib.default_augment(extra=True)\n",
        "\n",
        "runs = [\n",
        "    # 'no_aug' still gets the base flip/rotation/zoom every original run got\n",
        "    # (fishlib.default_augment(extra=False)) -- only the EXTRA tier varies\n",
        "    # across these three conditions, matching the original's own protocol.\n",
        "    ('v2_E_no_aug',            fishlib.default_augment(extra=False), False),\n",
        "    ('v2_E_targeted_original', default_targeted_augment(),            True),\n",
        "    ('v2_E_symmetric_new',     v2.realistic_augment(),                False),\n",
        "]\n",
        "\n",
        "for tag, aug, targeted in runs:\n",
        "    train_ds, val_ds, test_ds = fishlib.load_splits(\n",
        "        'imbalanced', augment=aug, targeted=targeted)\n",
        "    model = fishlib.build_model(backbone=BACKBONE, mode=MODE, n_classes=16)\n",
        "    fishlib.train(model, train_ds, val_ds, epochs=20, lr=1e-3, tag=tag)\n",
        "    fishlib.evaluate(model, test_ds, tag=tag)\n"
      ],
      "id": "6vswgskxDXzR"
