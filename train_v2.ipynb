      "source": [
        "BACKBONE, MODE = 'efficientnetb0', 'frozen'   # matches the original's best model\n",
        "\n",
        "results_v1 = {}\n",
        "for branch, tag in [('image', 'v2_D_image_only'),\n",
        "                     ('metadata', 'v2_D_metadata_only'),\n",
        "                     ('both', 'v2_D_fused')]:\n",
        "    aug = v2.realistic_augment() if branch in ('image', 'both') else None\n",
        "    train_ds, val_ds, test_ds = v2.load_splits_meta('balanced', augment=aug, branch=branch)\n",
        "    model = v2.build_fused_model(backbone=BACKBONE, mode=MODE, n_classes=16, branch=branch)\n",
        "    fishlib.train(model, train_ds, val_ds, epochs=20, lr=1e-3, tag=tag)\n",
        "    results_v1[tag] = fishlib.evaluate(model, test_ds, tag=tag)\n"
      ],
